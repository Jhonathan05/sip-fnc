# SIP-FNC — plantilla pública (cero secretos reales). Copiar a .env y completar.
APP_NAME=sip-fnc
APP_PORT=3020
NODE_ENV=development

# Base pública de la app (frontchannel para el browser)
NEXTAUTH_URL=http://localhost:3020
# Reflejo público de AUTH_PROVIDER para el cliente (login muestra botón dev)
NEXT_PUBLIC_AUTH_PROVIDER=mock

# Proveedor de autenticación: mock (dev offline) | keycloak (staging/prod)
AUTH_PROVIDER=mock

# Solo mock: roles del mock local (coma; admin -> ADMIN, resto -> FUNCIONARIO)
MOCK_ROLES=admin
# Catálogo de client roles de la app (coma; nace en P0 aunque no haya login)
CLIENT_ROLES=admin,coordinador,consultor,analista,auxiliar

# Rate limit (override en caliente desde panel admin; declarar también en compose)
RATE_LIMIT_API_PER_MIN=600

# Sesión iron-session (≥32 chars; generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=CAMBIAR_generar_64_hex
# Cifrado app (SEPARADA de SESSION_SECRET, ≥32 chars)
ENCRYPTION_KEY=CAMBIAR_generar_64_hex_distinta

# Postgres (dev local vía compose; prod en host FNC)
DATABASE_URL=postgresql://sip:sip@localhost:5433/sip_fnc

# ── Solo si AUTH_PROVIDER=keycloak ──────────────────────────────────────────
# split-brain: backchannel interno Docker vs frontchannel browser (NUNCA mezclar)
KEYCLOAK_URL=http://fnc-keycloak:8080/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
KEYCLOAK_REALM=fnc-realm
KEYCLOAK_CLIENT_ID=sip-fnc-client
KEYCLOAK_CLIENT_SECRET=obtener_de_secrets-clients.txt

# Plantilla FNC (copiar a .env y completar). Modo B: dev offline sin KC ni infra FNC.
APP_NAME=sip-fnc
PORT=3020
APP_BASE=http://localhost:3020
# Proveedor: mock (dev offline, sin Keycloak) | keycloak (staging/prod contra infra FNC)
AUTH_PROVIDER=mock
# Roles del mock local (coma): admin -> ADMIN, resto -> FUNCIONARIO
MOCK_ROLES=admin
# Catálogo de client roles de la app (coma; nace en P0 aunque no haya login)
CLIENT_ROLES=admin,coordinador,consultor,analista,auxiliar
RATE_LIMIT_API_PER_MIN=60
# ── Solo si AUTH_PROVIDER=keycloak (prod: client registrado en fnc-realm) ──
# split-brain: backchannel interno Docker vs frontchannel browser (NUNCA mezclar)
KEYCLOAK_URL=http://fnc-keycloak:8080/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
KEYCLOAK_REALM=fnc-realm
KEYCLOAK_CLIENT_ID=sip-fnc-client
KEYCLOAK_CLIENT_SECRET=obtener_de_secrets-clients.txt
SESSION_SECRET=cambia-esto-minimo-32-chars-1234567890
